<?xml version="1.0"?>

<package xmlns="http://schemas.microsoft.com/packaging/2011/10/nuspec.xsd">
  <metadata>
    <id>VL.Captury</id>
    <version>0.0.1-alpha</version>
    <title>VL.Captury</title>
    <authors>vvvv, captury</authors>
    <projectUrl>https://github.com/vvvv/VL.Captury</projectUrl>
    <repository type="git" url="https://github.com/vvvv/VL.Captury.git" />
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Support for markerless Skeleton tracking and ArTag tracking by Captury</description>
    <tags>VL, body, skeleton, artag, tracking, avateering, finger, hand</tags>
    <license type="expression">LGPL-3.0-only</license>
    <icon>icon\nugeticon.png</icon>
    <readme>docs\README.md</readme>
  </metadata>
  <files>
    <file src="..\lib\**\*.dll" target="lib\" exclude="" />
	<file src="..\runtimes\**\*.dll" target="runtimes\" exclude="" />
    <file src="..\*.vl" target="" exclude="" />
    <file src="..\help\**" target="help\" exclude="" />
    <file src="nugeticon.png" target="icon\" />
    <file src="..\README.md" target="docs\" />
  </files>
</package>
